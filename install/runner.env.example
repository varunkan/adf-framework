# Copy to .adf/runner.env (the installer writes this for you) and `set -a; . .adf/runner.env`.
# Selects which headless agent CLI drives the ADF orchestration server.

# auto | cursor | claude | custom
ADF_RUNNER=auto

# --- Cursor ---
# CURSOR_API_KEY=...
# CURSOR_AGENT_PATH=/Users/me/.local/bin/cursor-agent

# --- Claude Code ---
# ANTHROPIC_API_KEY=...
# ADF_CLAUDE_PATH=/opt/homebrew/bin/claude

# --- Ollama (local model, zero marginal cost, fully offline) ---
# Written for you by: adf install -t . -i generic -r ollama
# ADF_RUNNER=custom
# ADF_RUNNER_BIN="/path/to/adf-framework/scripts/orch/ollama_runner.sh"
# ADF_RUNNER_ARGS="{prompt} --workspace {workspace}"
# ADF_RUNNER_KILL_PATTERN="ollama_runner.sh"
# Alternatives: nemotron-mini (smallest), hf.co/MaziyarPanahi/NVIDIA-Nemotron-Nano-12B-v2-GGUF (higher quality)
# ORCH_OLLAMA_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3-Nano-4B-GGUF:Q4_K_M
# OLLAMA_HOST=http://127.0.0.1:11434
# Dashboard chat backend: auto = instant state answers, then local Ollama, then cursor-agent
# ORCH_CHAT_LLM=auto

# --- Model routing (complexity-based) ---
# Routes each LLM task to the cheapest tier that can handle it:
# instant (state, $0) -> local (Ollama, $0) -> fast -> balanced -> deep.
# auto | local-only | cloud-only
# ORCH_ROUTER=auto
# Cloud tiers need ANTHROPIC_API_KEY; without it the router degrades to
# local-only (never an error).
# ORCH_MODEL_FAST=claude-haiku-4-5
# ORCH_MODEL_BALANCED=claude-sonnet-4-6
# ORCH_MODEL_DEEP=claude-opus-4-8
# Per-task ceilings in seconds; on timeout escalate one tier, then mark blocked.
# ORCH_AGENT_TIMEOUT_SEC=30
# ORCH_RUNNER_TIMEOUT_SEC=30

# --- Custom (any agent CLI) ---
# ADF_RUNNER=custom
# ADF_RUNNER_BIN="/usr/local/bin/my-agent"
# ADF_RUNNER_ARGS="run --json --dir {workspace} {prompt}"
# ADF_RUNNER_API_KEY_ENV="MY_AGENT_TOKEN"
# ADF_RUNNER_KILL_PATTERN="my-agent"
