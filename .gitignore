# Dart / Flutter
.dart_tool/
build/
coverage/
*.iml
.packages
.pub-cache/

# Local machine config / secrets (never commit)
.env
.env.*.local
.env.groq.local

# ADF runtime (local)
orchestration/otel-traces.jsonl
orchestration/otel-session.json
orchestration/features/**/commands.jsonl
orchestration/features/**/run-log.jsonl
orchestration/features/**/otel-traces.jsonl
# Generated when the server/studio/tests run against the framework repo itself:
# orchestration runtime state, spec-kit state, and per-feature spec output.
.cursor/orchestration/
.adf/orchestration/
.specify/
specs/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Release build output (optional local)
dist/

# headroom integration (local venv — Python 3.13, litellm needs <3.14)
.venv-headroom/

# python bytecode
__pycache__/
*.pyc

# app runtime data
apps/*/expenses.json
apps/*/*.db
# Added by code-review-graph
.code-review-graph/

# Bench/export run artifacts (not source)
.adf-bench-workspace/
.adf-exports/

# ADF signing keys — NEVER commit the private seed (provenance signing)
.adf-keys/
*.adf-signing.key
adf-signing.key
