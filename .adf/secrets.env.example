# ADF local secrets — copy to .adf/secrets.env (gitignored), then fill in.
#   cp .adf/secrets.env.example .adf/secrets.env
#
# Claude Code SUBSCRIPTION token — makes ADF drive builds with the `claude` CLI at
# $0/token (the preferred runner). Mint it once in a normal Terminal:
#   claude setup-token
# then paste the printed sk-ant-oat01-… value here.
export CLAUDE_CODE_OAUTH_TOKEN=''
#
# NVIDIA NIM key (free) — the fallback implement runner (Nemotron Super 49B v1.5).
# Used when the Claude token is absent/expired. Get one at build.nvidia.com:
export NVIDIA_API_KEY=''
#
# Anthropic API key (paid) — deep-tier brain + Opus 4.8 runner when ADF_USE_OPUS=1.
# Optional; leave empty to skip the paid path.
export ANTHROPIC_API_KEY=''
